PORT=
NODE_ENV=development

# Leave empty to use local SQLite. For Postgres use:
# DATABASE_URL=postgres://user:password@localhost:5432/financedb
DATABASE_URL=

# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_SECRET=change_this_too

# Email (SMTP). If SMTP_HOST is empty, the OTP is printed in the terminal (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI Finance <no-reply@aifinance.app>"

CLIENT_URL=http://localhost:3000
